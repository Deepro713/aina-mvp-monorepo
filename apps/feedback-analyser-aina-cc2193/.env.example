# ── Database (Neon Postgres) ───────────────────────────────
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/feedback?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:password@ep-example.us-east-2.aws.neon.tech/feedback?sslmode=require

# ── Auth.js v5 ─────────────────────────────────────────────
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ── Magic-link email (Resend) ──────────────────────────────
RESEND_API_KEY=re_replace_me
EMAIL_FROM="Feedback Analyser <login@example.com>"
MAGIC_LINK_HOURLY_LIMIT=5
MAGIC_LINK_MAX_AGE_SECONDS=600

# ── User API-key encryption (AES-256-GCM) ──────────────────
KEY_ENCRYPTION_SECRET=replace-with-openssl-rand-base64-32
KEY_ENCRYPTION_VERSION=1

# ── LLM call guardrails ────────────────────────────────────
LLM_TIMEOUT_MS=45000
LLM_MAX_OUTPUT_TOKENS=300
ANALYZE_DAILY_LIMIT=500
NEXT_PUBLIC_BATCH_MAX_ENTRIES=25
NEXT_PUBLIC_BATCH_CONCURRENCY=3

# ── Prototype banner + footer link ─────────────────────────
NEXT_PUBLIC_REPO_URL=https://github.com/YOUR-ORG/feedback-analyser-aina

# ── Analytics (public pages only; leave blank to disable) ──
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
